<Page
    x:Name="RootPage"
    x:Class="JelliBox.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:JelliBox.ViewModels"
    Background="Black"
    KeyDown="Page_KeyDown">

    <Page.DataContext>
        <vm:PlayerViewModel />
    </Page.DataContext>

    <Grid x:Name="RootGrid">
        <!-- Video -->
        <MediaPlayerElement x:Name="Player"
                            AreTransportControlsEnabled="False"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            AutoPlay="True" />

        <!-- Controls overlay — fades out after inactivity -->
        <Grid x:Name="ControlsOverlay" PointerMoved="ControlsOverlay_PointerMoved">

            <!-- Top gradient + title & stream info -->
            <Grid VerticalAlignment="Top">
                <Rectangle Height="140">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E6000000" Offset="0" />
                            <GradientStop Color="#88000000" Offset="0.6" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="40,24,40,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Button + Title & Subtitle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Command="{Binding GoBackCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                Width="44" Height="44" CornerRadius="22"
                                AutomationProperties.Name="Back">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" FontSize="16" />
                        </Button>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding ItemTitle}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{Binding ItemSubtitle}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding ItemSubtitle, Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Stream Format & Quality Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Direct Play / Transcode Pill -->
                        <Border Background="#2600E676" BorderBrush="#8000E676" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding IsTranscoding, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <TextBlock Text="DIRECT PLAY" Foreground="#00E676" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <Border Background="#26FFB300" BorderBrush="#80FFB300" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding IsTranscoding, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="TRANSCODE" Foreground="#FFB300" FontSize="11" FontWeight="Bold" />
                        </Border>

                        <!-- Resolution Badge -->
                        <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding ResolutionBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding ResolutionBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>

                        <!-- HDR Badge -->
                        <Border Background="#33FFD700" BorderBrush="#80FFD700" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding HdrBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding HdrBadge}" Foreground="#FFD700" FontSize="11" FontWeight="Bold" />
                        </Border>

                        <!-- Video Codec Badge -->
                        <Border Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding VideoCodecBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding VideoCodecBadge}" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                        </Border>

                        <!-- Audio Channels Badge -->
                        <Border Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding AudioBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                            <TextBlock Text="{Binding AudioBadge}" Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold" />
                        </Border>

                        <!-- Subtitle CC Active Badge -->
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="5" Padding="8,3"
                                Visibility="{Binding HasSubtitlesBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="CC" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Live Clock & Estimated Finish Time -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding CurrentClockText}"
                                   Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding EndsAtText}"
                                   Foreground="#AAFFFFFF" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding EndsAtText, Converter={StaticResource StringEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom gradient + controls & scrubber -->
            <Grid VerticalAlignment="Bottom">
                <Rectangle Height="220">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#99000000" Offset="0.4" />
                            <GradientStop Color="#F0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Margin="50,0,50,24" VerticalAlignment="Bottom" Spacing="10">
                    <!-- Multi-layered Scrubber Bar with Buffer Rail & Shimmer -->
                    <Grid Height="36" VerticalAlignment="Center">
                        <!-- Rail Base Track -->
                        <Border Height="6" CornerRadius="3" Background="#26FFFFFF"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <!-- Buffer Track: Shows what is downloaded ahead -->
                        <ProgressBar Minimum="0" Maximum="1000" Value="{Binding BufferPosition}"
                                     Height="6" CornerRadius="3"
                                     Foreground="#66FFFFFF" Background="Transparent"
                                     IsIndeterminate="False"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <!-- Active Buffering Shimmer Wave (Animates when buffering) -->
                        <ProgressBar Height="6" CornerRadius="3"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource AccentBrush}" Background="Transparent"
                                     Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibilityConverter}}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <!-- Played Track Fill -->
                        <ProgressBar Minimum="0" Maximum="1000" Value="{Binding SliderPosition}"
                                     Height="6" CornerRadius="3"
                                     Foreground="{StaticResource AccentBrush}" Background="Transparent"
                                     IsIndeterminate="False"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                        <!-- Interactive Gamepad Scrubber Slider -->
                        <Slider x:Name="TimelineSlider"
                                Minimum="0" Maximum="1000" StepFrequency="2"
                                Value="{Binding SliderPosition, Mode=TwoWay}"
                                Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                IsThumbToolTipEnabled="False"
                                Foreground="{StaticResource AccentBrush}"
                                Background="Transparent"
                                PointerCaptureLost="TimelineSlider_PointerCaptureLost"
                                PointerPressed="TimelineSlider_PointerPressed"
                                ValueChanged="TimelineSlider_ValueChanged"
                                KeyUp="TimelineSlider_KeyUp"
                                AutomationProperties.Name="Timeline scrubber" />
                    </Grid>

                    <!-- Time + Transport Controls + Options -->
                    <Grid>
                        <!-- Time display on left: Elapsed and Remaining -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TimeDisplay}"
                                       Foreground="White" FontWeight="SemiBold" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimeRemainingText}"
                                       Foreground="#88FFFFFF" FontSize="14"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding TimeRemainingText, Converter={StaticResource StringEmptyToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Center Playback Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Skip Back 10s -->
                            <Button Content="-10s" Command="{Binding SkipBackCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Width="90" Height="44" Padding="0" FontSize="13" FontWeight="SemiBold"
                                    AutomationProperties.Name="Rewind 10 seconds" />

                            <!-- Play / Pause Circle Button with Accent Glow -->
                            <Button x:Name="TogglePauseButton"
                                    Command="{Binding TogglePauseCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="64" Height="64" CornerRadius="32" Padding="0"
                                    AutomationProperties.Name="Play or pause">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="2,0,0,0"
                                              Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE769;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding IsPaused, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Skip Forward 30s -->
                            <Button Content="+30s" Command="{Binding SkipForwardCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Width="90" Height="44" Padding="0" FontSize="13" FontWeight="SemiBold"
                                    AutomationProperties.Name="Skip forward 30 seconds" />
                        </StackPanel>

                        <!-- Right Settings & Audio/Subtitle Options -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleAudioMenuCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="40" Padding="14,0" CornerRadius="20">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Audio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleSubtitleMenuCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="40" Padding="14,0" CornerRadius="20">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F0;" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Subtitles" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleVideoMenuCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="40" Padding="14,0" CornerRadius="20">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Quality" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Gamepad Navigation Legend / Controller Hints -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="Play/Pause" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="X" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="Subtitles" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="Y" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="Audio" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="LB / RB" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="-10s / +30s" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="Menu" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="Video Quality" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border Background="#33FFFFFF" CornerRadius="3" Padding="5,1"><TextBlock Text="B" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                            <TextBlock Text="Hide / Exit" FontSize="11" Foreground="#77FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Center HUD Feedback Flash (Seek / Pause Toast) -->
        <Border Background="#D9141418" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="24" Padding="28,14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowCenterHud, Converter={StaticResource BoolToVisibilityConverter}}"
                Canvas.ZIndex="170">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding CenterHudIcon}" FontSize="24" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CenterHudText}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Cinematic Loading & Buffering Card -->
        <Border x:Name="BufferingCard"
                Background="#F2121216"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="26,20"
                MinWidth="380" MaxWidth="480"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsBuffering, Converter={StaticResource BoolToVisibilityConverter}}"
                Canvas.ZIndex="180">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Grid ColumnSpacing="16" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Poster / Artwork Thumbnail -->
                    <Border Grid.Column="0" CornerRadius="8" Width="{Binding MiniPosterWidth}" Height="90"
                            Background="#22FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                            Visibility="{Binding PosterUrl, Converter={StaticResource NullToVisibilityConverter}}">
                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                    </Border>

                    <!-- Title & Stream Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ItemTitle}"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Text="{Binding ItemSubtitle}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold"
                                   Visibility="{Binding ItemSubtitle, Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />

                        <!-- Mini badges row -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Border Background="#2600E676" BorderBrush="#8000E676" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding PlayMethodBadge}" Foreground="#00E676" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding ResolutionBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                                <TextBlock Text="{Binding ResolutionBadge}" Foreground="White" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <Border Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{Binding AudioBadge, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                                <TextBlock Text="{Binding AudioBadge}" Foreground="#CCFFFFFF" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Buffering Progress & Status Text -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <Grid>
                        <TextBlock Text="{Binding BufferingText}" Foreground="#CCFFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding BufferingPercentText}" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"
                                   Visibility="{Binding HasBufferingPercent, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <!-- Indeterminate or Determinate Progress Bar with Accent Shimmer -->
                    <ProgressBar Height="4" CornerRadius="2"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding BufferingProgressValue}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#26FFFFFF"
                                 HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Floating Skip Intro / Outro Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,60,110" Canvas.ZIndex="120">
            <Button Command="{Binding SkipIntroCommand}"
                    Visibility="{Binding ShowSkipIntro, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource GhostButtonStyle}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    Height="48" Padding="20,0"
                    AutomationProperties.Name="Skip Intro">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="SKIP INTRO" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE793;" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding SkipOutroCommand}"
                    Visibility="{Binding ShowSkipOutro, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource GhostButtonStyle}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                    Height="48" Padding="20,0"
                    AutomationProperties.Name="Skip Outro">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="SKIP OUTRO" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE793;" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Audio Tracks Menu -->
        <Border x:Name="AudioMenuBorder"
                Background="#F2141416" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="24" Width="440" MaxHeight="520"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,130"
                Visibility="{Binding IsAudioMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Canvas.ZIndex="150">
            <StackPanel Spacing="16">
                <Grid>
                    <TextBlock Text="AUDIO TRACKS" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <Button Command="{Binding CloseMenusCommand}" Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right" Width="36" Height="36" Padding="0">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectAudioTrackCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Height="48" Margin="0,4" Padding="16,0">
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Subtitles Menu -->
        <Border x:Name="SubtitleMenuBorder"
                Background="#F2141416" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="24" Width="460" MaxHeight="620"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,130"
                Visibility="{Binding IsSubtitleMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Canvas.ZIndex="150">
            <StackPanel Spacing="14">
                <Grid>
                    <TextBlock Text="SUBTITLES" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                    <Button Command="{Binding CloseMenusCommand}" Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Right" Width="36" Height="36" Padding="0">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SubtitleTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectSubtitleTrackCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Height="44" Margin="0,3" Padding="14,0">
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Subtitle Timing / Sync Offset -->
                <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="SUBTITLE SYNC OFFSET" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SubtitleOffsetText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-0.5s" Command="{Binding SubtitleDelayMinusHalfCommand}" Style="{StaticResource GhostButtonStyle}" Height="34" FontSize="12" />
                            <Button Grid.Column="1" Content="-0.25s" Command="{Binding SubtitleDelayMinusCommand}" Style="{StaticResource GhostButtonStyle}" Height="34" FontSize="12" />
                            <Button Grid.Column="2" Content="+0.25s" Command="{Binding SubtitleDelayPlusCommand}" Style="{StaticResource GhostButtonStyle}" Height="34" FontSize="12" />
                            <Button Grid.Column="3" Content="+0.5s" Command="{Binding SubtitleDelayPlusHalfCommand}" Style="{StaticResource GhostButtonStyle}" Height="34" FontSize="12" />
                        </Grid>
                        <Button Content="Reset Sync to 0s" Command="{Binding SubtitleDelayResetCommand}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Stretch" Height="32" FontSize="12" Foreground="#88FFFFFF" />
                    </StackPanel>
                </Border>

                <!-- Subtitle Burn-In Mode Toggle (Anime/Complex typesetting) -->
                <Border BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,8,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                            <TextBlock Text="Burn Complex Subtitles" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Transcodes video for advanced ASS font typesetting" FontSize="11" Foreground="#88FFFFFF" />
                        </StackPanel>
                        <ToggleSwitch IsOn="{Binding BurnInSubtitles, Mode=TwoWay}" HorizontalAlignment="Right" OnContent="" OffContent="" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Video & Letterboxing Settings Menu -->
        <Border x:Name="VideoMenuBorder"
                Background="#F2141416" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="24" Width="460" MaxHeight="600"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,130"
                Visibility="{Binding IsVideoMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Canvas.ZIndex="150">
            <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="VIDEO SETTINGS" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                        <Button Command="{Binding CloseMenusCommand}" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" Width="36" Height="36" Padding="0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Aspect Ratio / Letterboxing -->
                    <TextBlock Text="ASPECT RATIO / LETTERBOXING" Style="{StaticResource FieldLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding StretchOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectStretchCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Height="44" Margin="0,3" Padding="16,0">
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center" />
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,6" />

                    <!-- Streaming Quality -->
                    <TextBlock Text="STREAMING QUALITY" Style="{StaticResource FieldLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding QualityOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectQualityCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Height="44" Margin="0,3" Padding="16,0">
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center" />
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Error banner -->
        <Border x:Name="ErrorBanner" Background="#E5101010" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2" CornerRadius="12" Padding="32,24" MaxWidth="640"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Canvas.ZIndex="200">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="Playback Failed" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessageText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                <Button x:Name="ErrorGoBackButton" Content="Go Back" Command="{Binding GoBackCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Width="160" Height="44" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
