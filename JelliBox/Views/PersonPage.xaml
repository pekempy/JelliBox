<Page
    x:Class="JelliBox.Views.PersonPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:JelliBox.ViewModels"
    xmlns:ctrl="using:JelliBox.Controls"
    xmlns:m="using:JelliBox.Models"
    KeyDown="Page_KeyDown"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.DataContext>
        <vm:PersonViewModel />
    </Page.DataContext>

    <Grid>
        <!-- Soft artwork glow behind the page (when enabled in Settings) -->
        <ctrl:AmbientBackdrop />

        <ProgressRing IsActive="{Binding IsLoading}"
                      Width="28" Height="28"
                      Foreground="{StaticResource AccentBrush}"
                      VerticalAlignment="Top" HorizontalAlignment="Right"
                      Margin="0,72,40,0" Canvas.ZIndex="10"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Main Content -->
        <ScrollViewer Margin="0,56,0,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="48,24,48,60" Spacing="36">

                <!-- Profile Hero -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Photo -->
                    <Border Grid.Column="0" Width="160" Height="160" CornerRadius="80"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderThickness="3" BorderBrush="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{Binding PhotoUrl}" DecodePixelWidth="160" />
                            </Image.Source>
                        </Image>
                    </Border>

                    <!-- Name & Bio -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" Spacing="8">
                        <TextBlock Text="{Binding Person.Name}"
                                   Style="{StaticResource HeroTitleStyle}"
                                   FontSize="38" />

                        <TextBlock Text="{Binding Description}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding Description, Converter={StaticResource StringEmptyToVisibilityConverter}}" />

                        <TextBlock Text="{Binding Bio}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   LineHeight="20"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding Bio, Converter={StaticResource StringEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <!-- Section: In Your Jellyfin Library -->
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="IN YOUR JELLYFIN LIBRARY" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                        <Border Background="{StaticResource SuccessBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LibraryItems.Count}" FontSize="12" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
                        <ItemsControl ItemsSource="{Binding LibraryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:MediaCard Item="{Binding}"
                                                    Command="{Binding DataContext.OpenMediaItemCommand, ElementName=RootPage}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Section: Other Notable Works & Filmography -->
                <StackPanel Spacing="14" Visibility="{Binding HasFilmography, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="FILMOGRAPHY &amp; OTHER WORKS" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                    <TextBlock Text="Cross-referenced with your Jellyfin library collection" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#22FFFFFF">
                        <ItemsControl ItemsSource="{Binding Filmography}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#15FFFFFF" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Year -->
                                            <TextBlock Grid.Column="0" Text="{Binding Year}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Title, MediaType & Role -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="White" VerticalAlignment="Center" />
                                                    <Border Background="#26FFFFFF" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding MediaType, Converter={StaticResource NullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding MediaType}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Role}" FontSize="13"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding Role, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </StackPanel>

                                            <!-- Availability Badge -->
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenMediaItemCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding MediaItem}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Height="32" Padding="10,0"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        Visibility="{Binding IsInLibrary, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                                                        <TextBlock Text="IN LIBRARY" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                                                    </StackPanel>
                                                </Button>

                                                <TextBlock Text="NOT IN LIBRARY"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsInLibrary, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- The navigation bar shared by every page -->
        <ctrl:TopNavBar x:Name="TopBar" Current="" Canvas.ZIndex="100" />
    </Grid>
</Page>
