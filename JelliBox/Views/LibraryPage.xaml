<Page
    x:Class="JelliBox.Views.LibraryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:JelliBox.ViewModels"
    xmlns:ctrl="using:JelliBox.Controls"
    KeyDown="Page_KeyDown"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.DataContext>
        <vm:LibraryViewModel />
    </Page.DataContext>

    <Page.Resources>
        <!-- Tile containers: no selection chrome and no focus stop of their own (the card's button takes focus). -->
        <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Soft artwork glow behind the page (when enabled in Settings) -->
        <ctrl:AmbientBackdrop />

        <!-- Main Content Area with Right-hand Jump List -->
        <Grid x:Name="ContentArea" Margin="0,56,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: virtualized grid of cards (only tiles near the screen exist, so 2,000+ items stay smooth) -->
            <GridView x:Name="TileGrid" Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      ItemContainerStyle="{StaticResource TileContainerStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      IsTabStop="False"
                      Padding="48,0,12,0"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.Header>
                    <StackPanel>
                        <!-- Name of a collection or folder (top-level libraries are named by the bar) -->
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource HeroTitleStyle}"
                                   FontSize="24" Margin="0,18,0,0"
                                   Visibility="{Binding ShowTitle, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Active Letter Banner if jumped -->
                        <Border Margin="0,14,0,0" Padding="14,6" CornerRadius="6" Background="#26FFFFFF"
                                HorizontalAlignment="Left"
                                Visibility="{Binding SelectedLetter, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Showing from letter:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedLetter}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <Button Command="{Binding SelectLetterCommand}" CommandParameter="ALL"
                                        Style="{StaticResource GhostButtonStyle}" Height="26" Padding="8,0" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="9" VerticalAlignment="Center" />
                                        <TextBlock Text="CLEAR" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Load earlier items (only after jumping into the middle of a paged list) -->
                        <Button Content="LOAD EARLIER"
                                Command="{Binding LoadMoreAboveCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Center"
                                Width="240"
                                Margin="0,16,0,0"
                                Visibility="{Binding HasMoreAbove, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <Rectangle Height="16" />
                    </StackPanel>
                </GridView.Header>

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Tile size and column count are switched per view mode in code-behind -->
                        <ItemsWrapGrid Orientation="Horizontal"
                                       ItemWidth="136" ItemHeight="236"
                                       MaximumRowsOrColumns="12" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <ctrl:MediaCard Item="{Binding}"
                                        Command="{Binding DataContext.OpenItemCommand, ElementName=RootPage}"
                                        Margin="0,0,16,20" />
                    </DataTemplate>
                </GridView.ItemTemplate>

                <GridView.Footer>
                    <!-- Load more button (only if not ShowAll) -->
                    <Button Content="LOAD MORE"
                            Command="{Binding LoadMoreCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Center"
                            Width="240"
                            Margin="0,0,0,48"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibilityConverter}}" />
                </GridView.Footer>
            </GridView>

            <!-- Column 1: Alphabetical Jump List on the Right-hand side (Borderless) -->
            <Border x:Name="JumpList" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                    Margin="0,8,6,8" Padding="2,4">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Letters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.SelectLetterCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource JumpListButtonStyle}"
                                        Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Sort & filter panel -->
        <Border x:Name="FilterPanel"
                Canvas.ZIndex="30"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,64,36,0" Padding="22,18" Width="620"
                CornerRadius="12" Background="#F5101015"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                Visibility="{Binding IsFilterMenuOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="14">
                <TextBlock Text="SORT &amp; FILTER" FontSize="13" FontWeight="Bold" CharacterSpacing="120"
                           Foreground="{StaticResource AccentBrush}" />

                <!-- Rows scroll if the panel is taller than the screen -->
                <ScrollViewer x:Name="FilterScroller" MaxHeight="340"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Margin="0,4,12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sort by" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="320" Height="40" FontSize="13" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Order" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SortAscendingCommand}" IsEnabled="{Binding CanChooseOrder}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsAscending, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="ASCENDING" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SortDescendingCommand}" IsEnabled="{Binding CanChooseOrder}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsDescending, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="DESCENDING" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Watched" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SetPlayedFilterCommand}" CommandParameter="Any"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsPlayedAny, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="ANY" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetPlayedFilterCommand}" CommandParameter="Played"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsPlayedOnly, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="PLAYED" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetPlayedFilterCommand}" CommandParameter="Unplayed"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsUnplayedOnly, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="UNPLAYED" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subtitles" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SubtitlesAllCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsAllSubtitles, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="ANY" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SubtitlesOnlyCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding SubtitlesOnly, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="SUBTITLED" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Genre" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="320" Height="40" FontSize="13" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Audio language" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AudioLanguageOptions}" SelectedItem="{Binding SelectedAudioLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="320" Height="40" FontSize="13" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Subtitle language" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SubtitleLanguageOptions}" SelectedItem="{Binding SelectedSubtitleLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="Label" Width="320" Height="40" FontSize="13" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Items" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ShowPagedCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding IsPagedMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="PAGED" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShowAllCommand}"
                                    Style="{StaticResource GhostButtonStyle}" Height="38" Padding="12,0" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                              Visibility="{Binding ShowAll, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="SHOW ALL" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Grid>

                        <Button Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource GhostButtonStyle}" Height="40" HorizontalAlignment="Left" Padding="18,0" FontSize="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="RESET SORT &amp; FILTERS" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="Press B to close" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- The navigation bar shared by every page -->
        <ctrl:TopNavBar x:Name="TopBar" Current="" Canvas.ZIndex="100">
            <ctrl:TopNavBar.Extra>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing IsActive="{Binding IsLoading}"
                                  Width="22" Height="22"
                                  Foreground="{StaticResource AccentBrush}"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- The one thing the library adds to the shared bar -->
                    <Button x:Name="FilterButton"
                            Command="{Binding ToggleFilterMenuCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="34" Padding="12,0" CornerRadius="17"
                            AutomationProperties.Name="Sort and filter">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FilterSummary}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctrl:TopNavBar.Extra>
        </ctrl:TopNavBar>
    </Grid>
</Page>
