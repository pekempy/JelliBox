<UserControl
    x:Class="JelliBox.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JelliBox.Controls"
    x:Name="Self">

    <UserControl.Resources>
        <!-- Scale up on focus -->
        <Storyboard x:Name="FocusIn">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                             To="1.06" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                             To="1.06" Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FocusOut">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                             To="1.0" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                             To="1.0" Duration="0:0:0.12" />
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusBorder" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Button x:Name="CardButton"
            Padding="0" Background="Transparent" BorderThickness="0"
            UseSystemFocusVisuals="False"
            Command="{Binding Command, ElementName=Self}"
            CommandParameter="{Binding Item, ElementName=Self}"
            GotFocus="CardButton_GotFocus"
            LostFocus="CardButton_LostFocus"
            KeyDown="CardButton_KeyDown"
            ContextRequested="CardButton_ContextRequested"
            AutomationProperties.Name="{Binding Item.Name, ElementName=Self}">

        <Button.ContextFlyout>
            <MenuFlyout x:Name="CardMenuFlyout" Opening="CardMenuFlyout_Opening">
                <MenuFlyoutItem Text="Play" Click="OnPlayClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Details" Click="OnDetailsClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FavoriteMenuItem" Text="Add to Favourites" Click="OnFavoriteClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon x:Name="FavoriteMenuIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE734;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WatchedMenuItem" Text="Mark as Watched" Click="OnWatchedClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon x:Name="WatchedMenuIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Add to Collection..." Click="OnAddToCollectionClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="ContinueWatchingSeparator" />
                <MenuFlyoutItem x:Name="RemoveFromContinueWatchingMenuItem"
                                Text="Remove from Continue Watching"
                                Click="OnRemoveFromContinueWatchingClicked">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.ContextFlyout>

        <Grid x:Name="CardRoot">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Grid.RenderTransform>

            <StackPanel x:Name="CardContent">
                <!-- Poster/Still Surface (100% CLEAN ARTWORK - NO OVERLAYS BLOCKING IT!) -->
                <Grid>
                    <Border x:Name="CardSurface"
                            CornerRadius="8"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderThickness="1"
                            BorderBrush="#1AFFFFFF">
                        <Grid>
                            <!-- Thumbnail -->
                            <Image x:Name="Thumbnail"
                                   Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage x:Name="ThumbSource" />
                                </Image.Source>
                            </Image>

                            <!-- Progress bar (continue watching) -->
                            <Grid VerticalAlignment="Bottom"
                                  Visibility="{Binding ShowProgress, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Rectangle Height="4" Fill="#33FFFFFF" HorizontalAlignment="Stretch" />
                                <Rectangle x:Name="ProgressBar" Height="4" Fill="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Left" />
                            </Grid>

                            <!-- Watched tick -->
                            <Border x:Name="WatchedBadge" Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4"
                                    Padding="5,3" Margin="8,8,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding Item.UserData.Played, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                          FontSize="11" />
                            </Border>

                            <!-- Collection badge -->
                            <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4"
                                    Padding="6,4" Margin="0,0,8,8"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding Item.IsCollection, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" Foreground="White" FontSize="13" />
                            </Border>

                            <!-- Subtitles indicator badge -->
                            <Border Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="4"
                                    Padding="5,2" Margin="0,8,8,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding Item.HasSubtitles, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="CC" Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Focus ring (around the artwork surface only) -->
                    <Border x:Name="FocusBorder"
                            BorderBrush="White" BorderThickness="3"
                            CornerRadius="8" Visibility="Collapsed"
                            Margin="-3" />
                </Grid>

                <!-- Title & Subtitle BELOW the artwork, unblocking 100% of the poster -->
                <StackPanel Margin="2,5,2,0" Spacing="2" Height="36" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Item.CardTitle, ElementName=Self}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Item.CardSubtitle, ElementName=Self}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               FontWeight="Medium"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Item.CardSubtitle, ElementName=Self, Converter={StaticResource NullToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
