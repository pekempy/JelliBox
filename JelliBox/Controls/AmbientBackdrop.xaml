<UserControl
    x:Class="JelliBox.Controls.AmbientBackdrop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <Grid IsHitTestVisible="False">
        <!-- Two layers so artwork cross-fades instead of popping -->
        <Image x:Name="LayerA" Stretch="UniformToFill" Opacity="0" />
        <Image x:Name="LayerB" Stretch="UniformToFill" Opacity="0" />

        <!-- Darkening so text stays readable, fading to the page colour at the bottom -->
        <Rectangle x:Name="Shade" Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0" />
                    <GradientStop Color="#D90D0D0D" Offset="0.55" />
                    <GradientStop Color="#FF0D0D0D" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
